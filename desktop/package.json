{
  "name": "bahadur-billing",
  "productName": "Bahadur Billing",
  "version": "1.0.0",
  "description": "Billing desktop app for Bahadur Tours and Travels",
  "author": "Bahadur Tours and Travels",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.bahadurtours.billing",
    "productName": "Bahadur Billing",
    "files": [
      "main.js",
      "offline.html"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Bahadur Billing",
      "artifactName": "Bahadur-Billing-Setup.${ext}"
    }
  }
}